#!/usr/bin/env groovy

def stageProjectName = 'stage'
def services = ['auth', 'identity', 'form', 'file', 'dashboard', 'notification', 'gateway', 'promotion']
def hashes = [:]

pipeline {

    agent {
        kubernetes {
            defaultContainer 'kubectl'
            namespace 'jenkins-agents'
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              containers:
                - name: kubectl
                  image: line/kubectl-kustomize:latest
                  command: ["cat"]
                  tty: true
                - name: git
                  image: alpine/git:latest
                  command: ["cat"]
                  tty: true
            '''
        }
    }

    environment {
        REPO = 'prapoju/circle-guard-public'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Load Stage Hashes') {
            steps {
                script {
                    services.each { svc ->
                        copyArtifacts(projectName: stageProjectName, filter: "commit-hash-${svc}.txt")
                        hashes[svc] = readFile("commit-hash-${svc}.txt").trim()
                        echo "[${svc}] hash: ${hashes[svc]}"
                    }
                }
            }
        }

        stage('Deploy to Master') {
            steps {
                container('kubectl') {
                    script {
                        def kustomizeCommands = services.collect { svc ->
                            "kustomize edit set image prapoju/circleguard-${svc}-service:stage=prapoju/circleguard-${svc}-service:${hashes[svc]}"
                        }.join('\n')

                        sh """
                            cd k8s/overlays/master
                            ${kustomizeCommands}
                            kustomize build | kubectl apply -f -
                        """
                    }
                }
            }
        }

        stage('Verify Rollout') {
            steps {
                container('kubectl') {
                    script {
                        services.each { svc ->
                            sh "kubectl rollout status deployment/${svc}-service -n circleguard-master --timeout=180s"
                        }
                    }
                }
            }
        }

        stage('Save Artifacts') {
            steps {
                script {
                    def fileList = services.collect { svc -> "commit-hash-${svc}.txt" }.join(',')
                    archiveArtifacts artifacts: fileList, fingerprint: true
                }
            }
        }

        stage('Generate Release Notes') {
            steps {
                container('git') {
                  withCredentials([usernamePassword(credentialsId: 'github-app',
                                                    usernameVariable: 'GITHUB_APP',
                                                  passwordVariable: 'GITHUB_ACCESS_TOKEN')]) {
                        sh '''
                            # ─────────────────────────────────────────────
                            # DEPENDENCIAS
                            # ─────────────────────────────────────────────
                            apk add --no-cache curl jq
                            git config --global --add safe.directory "$WORKSPACE"

                            # Caracter backtick como variable para evitar conflictos con Groovy
                            BT='`'

                            # ─────────────────────────────────────────────
                            # 1. VERSIONAMIENTO
                            # ─────────────────────────────────────────────
                            # La version se compone de tres partes:
                            #   1. Fecha del build     -> orden cronologico y trazabilidad del deploy
                            #   2. Commit del repo     -> estado del codigo fuente (Jenkinsfile, k8s, configs)
                            #   3. Commit de la imagen -> codigo que corren los contenedores en produccion
                            #
                            # Formato: v<YEAR>.<MONTH>.<DAY>-<sha_repo>-<sha_imagen>
                            # Ejemplo: v2025.06.01-b1c2d3e-a3f9c12
                            #
                            IMAGE_COMMIT=$(cat commit-hash-auth.txt)
                            SHA_REPO=$(git rev-parse --short HEAD)
                            SHA_IMAGE=$(echo "$IMAGE_COMMIT" | cut -c1-7)
                            VERSION="v$(date +%Y.%m.%d)-${SHA_REPO}-${SHA_IMAGE}"

                            echo "Version generada: $VERSION"
                            echo "  - Fecha:         $(date +%Y.%m.%d)"
                            echo "  - Commit repo:   $SHA_REPO"
                            echo "  - Commit imagen: $SHA_IMAGE"

                            # ─────────────────────────────────────────────
                            # 2. RELEASE NOTES
                            # ─────────────────────────────────────────────
                            # Buscamos el tag mas reciente para saber desde donde
                            # listar commits nuevos. Si no hay tag previo es la primera release.
                            #
                            PREV_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

                            if [ -z "$PREV_TAG" ]; then
                                # Primera release: tomamos todo el historial
                                echo "Sin tag previo — incluyendo todo el historial de commits"
                                LOG=$(git log --pretty=format:"%s|%an")
                            else
                                # Releases siguientes: solo commits despues del tag anterior
                                echo "Tag anterior encontrado: $PREV_TAG — listando commits nuevos"
                                LOG=$(git log ${PREV_TAG}..HEAD --pretty=format:"%s|%an")
                            fi

                            # Clasificamos por tipo de commit (Conventional Commits):
                            #   feat: -> nueva funcionalidad
                            #   fix:  -> correccion de bug
                            #   docs: -> documentacion
                            #   test: -> tests
                            #   resto -> chore, refactor, style, etc.
                            #
                            FEATURES=$(echo "$LOG" | grep -i "^feat"  | sed 's/|/ - /' | sed 's/^/- /' || true)
                            FIXES=$(echo "$LOG"    | grep -i "^fix"   | sed 's/|/ - /' | sed 's/^/- /' || true)
                            DOCS=$(echo "$LOG"     | grep -i "^docs"  | sed 's/|/ - /' | sed 's/^/- /' || true)
                            TESTS=$(echo "$LOG"    | grep -i "^test"  | sed 's/|/ - /' | sed 's/^/- /' || true)
                            OTHERS=$(echo "$LOG"   | grep -iv "^feat\\|^fix\\|^docs\\|^test" | sed 's/|/ - /' | sed 's/^/- /' || true)

                            # Armamos el cuerpo del release en Markdown
                            BODY="## CircleGuard Release $VERSION"
                            BODY="$BODY
"
                            BODY="${BODY}**Commit repo:**   ${BT}${SHA_REPO}${BT}
"
                            BODY="${BODY}**Commit imagen:** ${BT}${IMAGE_COMMIT}${BT}

"
                            [ -n "$FEATURES" ] && BODY="${BODY}### New Features
${FEATURES}

"
                            [ -n "$FIXES" ]    && BODY="${BODY}### Bug Fixes
${FIXES}

"
                            [ -n "$DOCS" ]     && BODY="${BODY}### Documentation
${DOCS}

"
                            [ -n "$TESTS" ]    && BODY="${BODY}### Tests
${TESTS}

"
                            [ -n "$OTHERS" ]   && BODY="${BODY}### Other Changes
${OTHERS}

"
                            BODY="${BODY}---
_Jenkins build #${BUILD_NUMBER} - $(date '+%Y-%m-%d %H:%M:%S')_"

                            # ─────────────────────────────────────────────
                            # 3. PUBLICAR EN GITHUB
                            # ─────────────────────────────────────────────
                            # La API de GitHub crea el tag y el release en un solo paso.
                            # jq construye el JSON de forma segura escapando caracteres especiales.
                            #
                            curl -s -X POST "https://api.github.com/repos/${REPO}/releases" \
                                -H "Authorization: token $GITHUB_ACCESS_TOKEN" \
                                -H "Content-Type: application/json" \
                                -d "$(jq -n \
                                    --arg tag  "$VERSION" \
                                    --arg name "Release $VERSION" \
                                    --arg body "$BODY" \
                                    '{tag_name: $tag, name: $name, body: $body, draft: false, prerelease: false}')"

                            echo "Release $VERSION publicada exitosamente"
                        '''
                    }
                }
            }
        }

    }

    post {
        success {
            echo 'Master pipeline completed successfully! All services promoted to :master.'
        }
        failure {
            echo 'Master pipeline failed. Check the logs.'
        }
    }
}
