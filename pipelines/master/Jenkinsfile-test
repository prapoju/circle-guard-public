#!/usr/bin/env groovy

def stageProjectName = 'stage-test'

pipeline {

    agent {
        kubernetes {
            defaultContainer 'docker'
            namespace 'jenkins-agents'
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              containers:
                - name: docker
                  image: docker:24-dind
                  securityContext:
                    privileged: true
                  env:
                    - name: DOCKER_TLS_CERTDIR
                      value: ""
                  command: ["dockerd-entrypoint.sh"]
                  args: ["--host=tcp://0.0.0.0:2375","--host=unix:///var/run/docker.sock"]
                - name: kubectl
                  image: line/kubectl-kustomize:latest
                  command: ["cat"]
                  tty: true
                - name: git
                  image: alpine/git:latest
                  command: ["cat"]
                  tty: true
            '''
        }
    }

    environment {
        REPO = 'prapoju/circle-guard-public'
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    container('git') {
                        sh 'rm -rf * .git'
                        sh 'git clone https://github.com/prapoju/circle-guard-public -b feat/ci-cd .'
                        sh 'git config --global --add safe.directory "$(pwd)"'
                        commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                        echo "Commit hash: ${commitHash}"
                    }
                }
            }
        }

        stage('Pull Stage Images') {
            steps {
                container('docker') {
                    sh 'until docker info; do sleep 2; done'
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        script {
                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-auth.txt')
                            def authHash = readFile('commit-hash-auth.txt').trim()

                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-identity.txt')
                            def identityHash = readFile('commit-hash-identity.txt').trim()

                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-form.txt')
                            def formHash = readFile('commit-hash-form.txt').trim()

                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-file.txt')
                            def fileHash = readFile('commit-hash-file.txt').trim()

                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-dashboard.txt')
                            def dashboardHash = readFile('commit-hash-dashboard.txt').trim()

                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-notification.txt')
                            def notificationHash = readFile('commit-hash-notification.txt').trim()

                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-gateway.txt')
                            def gatewayHash = readFile('commit-hash-gateway.txt').trim()

                            copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-promotion.txt')
                            def promotionHash = readFile('commit-hash-promotion.txt').trim()

                            sh "docker login -u $DOCKER_USER -p $DOCKER_PASS"
                            sh "docker pull prapoju/circleguard-auth-service:${authHash}"
                            sh "docker pull prapoju/circleguard-identity-service:${identityHash}"
                            sh "docker pull prapoju/circleguard-form-service:${formHash}"
                            sh "docker pull prapoju/circleguard-file-service:${fileHash}"
                            sh "docker pull prapoju/circleguard-dashboard-service:${dashboardHash}"
                            sh "docker pull prapoju/circleguard-notification-service:${notificationHash}"
                            sh "docker pull prapoju/circleguard-gateway-service:${gatewayHash}"
                            sh "docker pull prapoju/circleguard-promotion-service:${promotionHash}"
                        }
                    }
                }
            }
        }

        stage('Deploy to Master') {
            steps {
                container('kubectl') {
                    script {
                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-auth.txt')
                        def authHash = readFile('commit-hash-auth.txt').trim()

                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-identity.txt')
                        def identityHash = readFile('commit-hash-identity.txt').trim()

                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-form.txt')
                        def formHash = readFile('commit-hash-form.txt').trim()

                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-file.txt')
                        def fileHash = readFile('commit-hash-file.txt').trim()

                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-dashboard.txt')
                        def dashboardHash = readFile('commit-hash-dashboard.txt').trim()

                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-notification.txt')
                        def notificationHash = readFile('commit-hash-notification.txt').trim()

                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-gateway.txt')
                        def gatewayHash = readFile('commit-hash-gateway.txt').trim()

                        copyArtifacts(projectName: stageProjectName, filter: 'commit-hash-promotion.txt')
                        def promotionHash = readFile('commit-hash-promotion.txt').trim()

                        sh """
                            cd k8s/overlays/master
                            kustomize edit set image prapoju/circleguard-auth-service:dev=prapoju/circleguard-auth-service:${authHash}
                            kustomize edit set image prapoju/circleguard-identity-service:dev=prapoju/circleguard-identity-service:${identityHash}
                            kustomize edit set image prapoju/circleguard-form-service:dev=prapoju/circleguard-form-service:${formHash}
                            kustomize edit set image prapoju/circleguard-file-service:dev=prapoju/circleguard-file-service:${fileHash}
                            kustomize edit set image prapoju/circleguard-dashboard-service:dev=prapoju/circleguard-dashboard-service:${dashboardHash}
                            kustomize edit set image prapoju/circleguard-notification-service:dev=prapoju/circleguard-notification-service:${notificationHash}
                            kustomize edit set image prapoju/circleguard-gateway-service:dev=prapoju/circleguard-gateway-service:${gatewayHash}
                            kustomize edit set image prapoju/circleguard-promotion-service:dev=prapoju/circleguard-promotion-service:${promotionHash}
                            kustomize build | kubectl apply -f -
                        """

                        sh "echo ${commitHash} > commit-hash-auth.txt"
                        sh "echo ${commitHash} > commit-hash-identity.txt"
                        sh "echo ${commitHash} > commit-hash-form.txt"
                        sh "echo ${commitHash} > commit-hash-file.txt"
                        sh "echo ${commitHash} > commit-hash-dashboard.txt"
                        sh "echo ${commitHash} > commit-hash-notification.txt"
                        sh "echo ${commitHash} > commit-hash-gateway.txt"
                        sh "echo ${commitHash} > commit-hash-promotion.txt"
                        archiveArtifacts artifacts: 'commit-hash-auth.txt,commit-hash-identity.txt,commit-hash-form.txt,commit-hash-file.txt,commit-hash-dashboard.txt,commit-hash-notification.txt,commit-hash-gateway.txt,commit-hash-promotion.txt', fingerprint: true
                    }
                }
            }
        }

        stage('Generate Release Notes') {
            steps {
                container('git') {
                    withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                        sh 'pipelines/scripts/release_notes.sh'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Master pipeline completed successfully! All services deployed and release notes published.'
        }
        failure {
            echo 'Master pipeline failed. Check the logs.'
        }
    }
}
