def fullImageFile = ''
def fullImageForm = ''
def fullImageGateway = ''
def fullImageIdentity = ''
def fullImageNotification = ''
def fullImagePromotion = ''

def fullImageFor(name) {
    switch(name) {
        case 'auth': return fullImageAuth
        case 'dashboard': return fullImageDashboard
        case 'file': return fullImageFile
        case 'form': return fullImageForm
        case 'gateway': return fullImageGateway
        case 'identity': return fullImageIdentity
        case 'notification': return fullImageNotification
        case 'promotion': return fullImagePromotion
        default: return ''
    }
}

