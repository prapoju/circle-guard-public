#!/usr/bin/env groovy

def serviceStatus = [:]
def commitHash = ''

def services = [
    [name: 'auth',         gradle: ':services:circleguard-auth-service',         dir: 'services/circleguard-auth-service',         image: 'prapoju/circleguard-auth-service',         compose: true],
    [name: 'dashboard',    gradle: ':services:circleguard-dashboard-service',    dir: 'services/circleguard-dashboard-service',    image: 'prapoju/circleguard-dashboard-service',    compose: true],
    [name: 'file',         gradle: ':services:circleguard-file-service',         dir: 'services/circleguard-file-service',         image: 'prapoju/circleguard-file-service',         compose: false],
    [name: 'form',         gradle: ':services:circleguard-form-service',         dir: 'services/circleguard-form-service',         image: 'prapoju/circleguard-form-service',         compose: false],
    [name: 'gateway',      gradle: ':services:circleguard-gateway-service',      dir: 'services/circleguard-gateway-service',      image: 'prapoju/circleguard-gateway-service',      compose: false],
    [name: 'identity',     gradle: ':services:circleguard-identity-service',     dir: 'services/circleguard-identity-service',     image: 'prapoju/circleguard-identity-service',     compose: false],
    [name: 'notification', gradle: ':services:circleguard-notification-service', dir: 'services/circleguard-notification-service', image: 'prapoju/circleguard-notification-service', compose: true],
    [name: 'promotion',    gradle: ':services:circleguard-promotion-service',    dir: 'services/circleguard-promotion-service',    image: 'prapoju/circleguard-promotion-service',    compose: false],
]

pipeline {

    agent {
        kubernetes {
            defaultContainer 'jdk21'
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              containers:
                - name: jdk21
                  image: eclipse-temurin:21-jdk
                  command: ["sleep"]
                  args: ["infinity"]
                  resources:
                    requests:
                      memory: "1Gi"
                      cpu: "500m"
                    limits:
                      memory: "3Gi"
                      cpu: "1500m"
                - name: docker
                  image: docker:24-dind
                  securityContext:
                    privileged: true
                  env:
                    - name: DOCKER_TLS_CERTDIR
                      value: ""
                  command: ["dockerd-entrypoint.sh"]
                  args: ["--host=tcp://0.0.0.0:2375","--host=unix:///var/run/docker.sock"]
                  resources:
                    requests:
                      memory: "512Mi"
                      cpu: "300m"
                    limits:
                      memory: "1Gi"
                      cpu: "500m"
                - name: git
                  image: alpine/git:latest
                  command: ["cat"]
                  tty: true
                  resources:
                    requests:
                      memory: "32Mi"
                      cpu: "50m"
                    limits:
                      memory: "64Mi"
                      cpu: "100m"
            '''
        }
    }

    environment {
        GRADLE_OPTS = '-Xmx1536m -Xms256m -XX:MaxMetaspaceSize=256m'
        JAVA_OPTS   = '-Xmx1536m'
        DOCKER_HOST = 'tcp://localhost:2375'
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    container('git') {
                        sh 'rm -rf * .git'
                        sh 'git clone https://github.com/prapoju/circle-guard-public -b develop .'
                        sh 'git config --global --add safe.directory "$(pwd)"'
                        commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                        echo "Commit hash: ${commitHash}"
                    }
                }
            }
        }

        stage('Compile & Unit Tests') {
            steps {
                script {
                    sh 'chmod +x gradlew'
                    sh './gradlew --no-daemon --version'
                    for (svc in services) {
                        def name   = svc.name
                        def gradle = svc.gradle
                        echo "-------- [${name}] Compiling --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel ${gradle}:compileJava"
                            sh "./gradlew --no-daemon --no-parallel ${gradle}:test"
                            serviceStatus[name] = 'ok'
                            echo "[${name}] Compile + Unit Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus[name] = 'fail'
                            echo "[${name}] Compile + Unit Tests: FAILED"
                        }
                    }
                }
            }
        }

        stage('Integration Tests') {
            steps {
                script {

                    // --- Auth ---
                    if (serviceStatus['auth'] == 'ok') {
                        echo "-------- [auth] Integration Tests --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-identity-service:bootJar"
                            container('docker') {
                                sh "docker compose -f services/circleguard-auth-service/docker-compose.integration.yml up -d --build"
                            }
                            sh 'sleep 60'
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-auth-service:integrationTest"
                            echo "[auth] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['auth'] = 'fail'
                            echo "[auth] Integration Tests: FAILED"
                        } finally {
                            container('docker') {
                                sh "docker compose -f services/circleguard-auth-service/docker-compose.integration.yml down -v || true"
                            }
                        }
                    } else {
                        echo "[auth] Skipping Integration Tests (compile/unit failed)"
                    }

                    // --- Dashboard ---
                    if (serviceStatus['dashboard'] == 'ok') {
                        echo "-------- [dashboard] Integration Tests --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-promotion-service:bootJar"
                            container('docker') {
                                sh "docker compose -f services/circleguard-dashboard-service/docker-compose.integration.yml up -d --build"
                            }
                            sh 'sleep 90'
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-dashboard-service:integrationTest"
                            echo "[dashboard] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['dashboard'] = 'fail'
                            echo "[dashboard] Integration Tests: FAILED"
                        } finally {
                            container('docker') {
                                sh "docker compose -f services/circleguard-dashboard-service/docker-compose.integration.yml down -v || true"
                            }
                        }
                    } else {
                        echo "[dashboard] Skipping Integration Tests (compile/unit failed)"
                    }

                    // --- File ---
                    if (serviceStatus['file'] == 'ok') {
                        echo "-------- [file] Integration Tests --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-file-service:integrationTest"
                            echo "[file] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['file'] = 'fail'
                            echo "[file] Integration Tests: FAILED"
                        }
                    } else {
                        echo "[file] Skipping Integration Tests (compile/unit failed)"
                    }

                    // --- Form ---
                    if (serviceStatus['form'] == 'ok') {
                        echo "-------- [form] Integration Tests --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-form-service:integrationTest"
                            echo "[form] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['form'] = 'fail'
                            echo "[form] Integration Tests: FAILED"
                        }
                    } else {
                        echo "[form] Skipping Integration Tests (compile/unit failed)"
                    }

                    // --- Gateway ---
                    if (serviceStatus['gateway'] == 'ok') {
                        echo "-------- [gateway] Integration Tests --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-gateway-service:integrationTest"
                            echo "[gateway] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['gateway'] = 'fail'
                            echo "[gateway] Integration Tests: FAILED"
                        }
                    } else {
                        echo "[gateway] Skipping Integration Tests (compile/unit failed)"
                    }

                    // --- Identity ---
                    if (serviceStatus['identity'] == 'ok') {
                        echo "-------- [identity] Integration Tests --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-identity-service:integrationTest"
                            echo "[identity] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['identity'] = 'fail'
                            echo "[identity] Integration Tests: FAILED"
                        }
                    } else {
                        echo "[identity] Skipping Integration Tests (compile/unit failed)"
                    }

                    // --- Notification ---
                    if (serviceStatus['notification'] == 'ok') {
                        echo "-------- [notification] Integration Tests --------"
                        try {
                            container('docker') {
                                sh "docker compose -f services/circleguard-notification-service/docker-compose.integration.yml up -d"
                            }
                            sh 'sleep 30'
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-notification-service:integrationTest"
                            echo "[notification] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['notification'] = 'fail'
                            echo "[notification] Integration Tests: FAILED"
                        } finally {
                            container('docker') {
                                sh "docker compose -f services/circleguard-notification-service/docker-compose.integration.yml down -v || true"
                            }
                        }
                    } else {
                        echo "[notification] Skipping Integration Tests (compile/unit failed)"
                    }

                    // --- Promotion ---
                    if (serviceStatus['promotion'] == 'ok') {
                        echo "-------- [promotion] Integration Tests --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel :services:circleguard-promotion-service:integrationTest"
                            echo "[promotion] Integration Tests: PASSED"
                        } catch (Exception e) {
                            serviceStatus['promotion'] = 'fail'
                            echo "[promotion] Integration Tests: FAILED"
                        }
                    } else {
                        echo "[promotion] Skipping Integration Tests (compile/unit failed)"
                    }
                }
            }
        }

        stage('Build & Push Images') {
            steps {
                script {
                    for (svc in services) {
                        def name   = svc.name
                        def gradle = svc.gradle
                        def dir    = svc.dir
                        def image  = svc.image

                        if (serviceStatus[name] != 'ok') {
                            echo "[${name}] Skipping Build & Push (previous stages failed)"
                            continue
                        }

                        echo "-------- [${name}] Build & Push --------"
                        try {
                            sh "./gradlew --no-daemon --no-parallel ${gradle}:bootJar"
                            container('docker') {
                                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                                    sh 'docker login -u $DOCKER_USER -p $DOCKER_PASS'
                                    sh "docker build -t ${image}:${commitHash} ${dir}/"
                                    sh "docker push ${image}:${commitHash}"
                                }
                            }
                            sh "echo ${commitHash} > commit-hash-${name}.txt"
                            archiveArtifacts artifacts: "commit-hash-${name}.txt", fingerprint: true
                            echo "[${name}] Build & Push: PASSED"
                        } catch (Exception e) {
                            serviceStatus[name] = 'fail'
                            echo "[${name}] Build & Push: FAILED"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo '========================================'
                echo '       Pipeline Results Summary'
                echo '========================================'
                for (svc in services) {
                    if (serviceStatus[svc.name] == 'ok') {
                        echo "[${svc.name}] SUCCESS"
                    } else {
                        echo "[${svc.name}] FAILED"
                    }
                }
                echo '========================================'
            }
        }
    }
}
